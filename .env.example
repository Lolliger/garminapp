# Copy to .env (never commit .env). Generate a token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_TOKEN=change-me
# Relay: where the SQLite file lives
RELAY_DB=relay/relay.db
# Hook + watch: public HTTPS URL of the relay (Tailscale Funnel / Cloudflare Tunnel), or http://127.0.0.1:8000 for local tests
RELAY_URL=http://127.0.0.1:8000
# Hook: how long to wait for an answer before falling back to the terminal prompt (seconds)
HOOK_TIMEOUT=120

# --- ntfy (optional, step 4). Leave NTFY_TOPIC empty to disable. ---
# Use a long random topic name (it is the only "password" on the public ntfy.sh): python3 -c "import secrets; print('claude-'+secrets.token_urlsafe(16))"
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
# Only if the topic is protected on your own ntfy server (access token, tk_...)
NTFY_TOKEN=
# Public HTTPS base URL of the relay as seen from your phone (the buttons call it). Must differ from nothing else; see docs/TUNNEL.md
PUBLIC_URL=
# Signs the ntfy answer links. Different from RELAY_TOKEN: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LINK_SECRET=
